{
  "name": "icecrew",
  "version": "1.0.1",
  "description": "Un pingouin compagnon en pixel art qui vit sous ton IA en terminal (Codex, Claude Code, Gemini CLI) et réagit tout seul.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preai": "npm run build",
    "ai": "node scripts/session.mjs",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KKanisvaran/Ai-reactions.git"
  },
  "keywords": [
    "cli",
    "terminal",
    "codex",
    "claude",
    "gemini",
    "reactions",
    "pixel-art",
    "companion",
    "penguin"
  ],
  "author": "KKanisvaran (KK LAB)",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bugs": {
    "url": "https://github.com/KKanisvaran/Ai-reactions/issues"
  },
  "homepage": "https://github.com/KKanisvaran/Ai-reactions#readme",
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "node-pty": "1.1.0"
  },
  "bin": {
    "icecrew": "bin/icecrew.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "~6.0.3"
  }
}
